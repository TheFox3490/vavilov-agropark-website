# Скопируй в .env и заполни. Файл .env в git не попадает (см. .gitignore).
# Пароли и ключи сгенерируй командой:  openssl rand -hex 32

# --- Порт наружу ------------------------------------------------------------
# На этот порт будет проксировать внешний nginx, который держит домен и TLS.
HTTP_PORT=8080
# Адрес, по которому сайт доступен снаружи. Используется в ссылках из писем.
PUBLIC_BASE_URL=https://example.ru

# --- База данных ------------------------------------------------------------
POSTGRES_DB=agropark
POSTGRES_USER=agropark
POSTGRES_PASSWORD=

# --- Ключи приложения -------------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
# true — если сайт открывается по https (на бою так и должно быть).
# Поставь false только для локальной проверки по http, иначе не залогинишься.
JWT_COOKIE_SECURE=true

# --- Первый администратор ---------------------------------------------------
# Создаётся автоматически при первом запуске. После входа смени пароль.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Регистрация ------------------------------------------------------------
# true — новый пользователь обязан подтвердить почту по ссылке из письма.
# Если SMTP ещё не настроен, поставь false, иначе никто не сможет войти.
REQUIRE_EMAIL_CONFIRMATION=true

# --- Почта (любой внешний SMTP, свой сервер не нужен) -----------------------
# Пока SMTP_HOST пустой, письма только пишутся в лог, сайт при этом работает.
# Gmail:      smtp.gmail.com,   порт 587, TLS, пароль приложения (нужна 2FA)
# Яндекс 360: smtp.yandex.ru,   порт 465, SSL
# Mail.ru:    smtp.mail.ru,     порт 465, SSL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=noreply@example.ru
MAIL_FROM_NAME=Агропарк Вавиловского университета
# Куда слать уведомления о новых заявках с формы обратной связи.
# Заявки в любом случае сохраняются в базе и видны в админке.
CONTACT_NOTIFY_TO=vr.techum@gmail.com

# --- Разработка (в проде не нужно) ------------------------------------------
# Токен Figma для скриптов в tools/ — к работе сайта отношения не имеет.
FIGMA_TOKEN=
FIGMA_FILE_KEY=duEWOObjREHBGdi7MTYpCw
